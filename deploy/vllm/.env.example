# Copy to .env and adjust paths for your host.
MODEL_DIR=/path/to/DeepSeek-V4-Flash-0731
# Use only for GitHub/PyPI installation; ModelScope downloads ignore it.
# GITHUB_PROXY=http://127.0.0.1:7890
CUDA_HOME=/usr/local/cuda-13.3
# Keep loopback unless authentication and network access controls are configured.
HOST=127.0.0.1
PORT=8000
SERVED_MODEL_NAME=DeepSeek-V4-Flash-0731
CUDA_VISIBLE_DEVICES=0,1,2,3,4,5,6,7
TENSOR_PARALLEL_SIZE=8
GPU_MEMORY_UTILIZATION=0.895
CPU_OFFLOAD_GB=0
MAX_MODEL_LEN=1024
MAX_NUM_SEQS=1
MAX_NUM_BATCHED_TOKENS=512
ENABLE_DSPARK=0
ENABLE_EXPERT_PARALLEL=0
# DSpark requires the V2 runner, but it does not fit on 24 GB cards here.
# VLLM_USE_V2_MODEL_RUNNER=1
ENFORCE_EAGER=1
NUM_SPECULATIVE_TOKENS=7
